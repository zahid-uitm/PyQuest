[sub_resource type="Shader" id="Shader_vault_conduits"]
code = "shader_type canvas_item;

void fragment() {
	vec4 base_col = texture(TEXTURE, UV);
	float purple_mask = clamp((base_col.b - base_col.g * 1.35) * (base_col.r - base_col.g * 0.9) * 6.0, 0.0, 1.0);
	float gold_mask = clamp((base_col.r - base_col.b * 1.45) * (base_col.g - base_col.b * 1.25) * 4.0, 0.0, 1.0);

	vec2 wp = UV * vec2(2400.0, 1350.0);
	float pulse = 0.5 + 0.5 * sin(TIME * 3.2 - length(wp - vec2(1215.0, 650.0)) * 0.015);
	float stream = 0.5 + 0.5 * sin(wp.y * 0.06 - TIME * 4.5 + sin(wp.x * 0.04) * 2.0);

	vec3 glow_rgb = base_col.rgb;
	glow_rgb += vec3(0.22, 0.08, 0.35) * purple_mask * stream * 0.85;
	glow_rgb += vec3(0.28, 0.20, 0.04) * gold_mask * pulse * 0.55;
	COLOR = vec4(glow_rgb, base_col.a);
}
"

