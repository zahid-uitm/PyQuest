[node name="Chests" type="Node2D" parent="YSortEntities"]

[node name="Chest1" parent="YSortEntities/Chests" instance=ExtResource("11_chest")]
position = Vector2(1465, 910)
chest_id = "w3_chest_dry"
lore_title = "The Principle of Modularity (DRY)"
lore_text = "Ancient Vault Scroll: DRY stands for 'Don't Repeat Yourself'. Wrapping repeated logic inside a Python 'def' function lets you update or debug the spell in one place and call it anywhere!"

[node name="Chest2" parent="YSortEntities/Chests" instance=ExtResource("11_chest")]
position = Vector2(255, 815)
chest_id = "w3_chest_defaults"
lore_title = "Scroll of Default Parameters"
lore_text = "Ancient Vault Scroll: In 'def cast_spell(mana, mult=2):', 'mult' has a default value of 2. Non-default parameters must always be listed BEFORE default parameters in the function header!"

[node name="Chest3" parent="YSortEntities/Chests" instance=ExtResource("11_chest")]
position = Vector2(2110, 425)
chest_id = "w3_chest_return"
lore_title = "print() vs. return"
lore_text = "Ancient Vault Scroll: 'print()' only displays text on the console and returns 'None'. Use 'return value' when you need to pass a function's output into another variable or calculation!"

[node name="Chest4" parent="YSortEntities/Chests" instance=ExtResource("11_chest")]
position = Vector2(1395, 385)
chest_id = "w3_chest_scope"
lore_title = "Local vs. Global Scope"
lore_text = "Ancient Vault Scroll: Variables created inside a function have Local Scope—they vanish once the function finishes! Return the result if you need to use it outside the function."

[node name="Slimes" type="Node2D" parent="YSortEntities"]

[node name="Slime1" parent="YSortEntities/Slimes" instance=ExtResource("12_slime")]
