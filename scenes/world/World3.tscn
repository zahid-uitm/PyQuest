[node name="Slime2" parent="YSortEntities/Slimes" instance=ExtResource("12_slime")]
position = Vector2(540, 745)
slime_name = "Param Slime"
quote_text = "Squish! Arguments are passed into parameters in order! ⚙️"

[node name="Slime3" parent="YSortEntities/Slimes" instance=ExtResource("12_slime")]
position = Vector2(1860, 825)
slime_name = "Return Slime"
quote_text = "Bloop! Without 'return', a Python function returns None! 🔮"

