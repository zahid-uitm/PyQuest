[sub_resource type="Shader" id="Shader_lava_flow"]
code = "shader_type canvas_item;

void fragment() {
	vec4 base_col = texture(TEXTURE, UV);
	float lava_mask = clamp((base_col.r - base_col.b * 1.8) * 2.2, 0.0, 1.0);
	vec2 wp = UV * vec2(2400.0, 1350.0);
	float pulse = 0.5 + 0.5 * sin(TIME * 3.2 + wp.y * 0.025 + sin(wp.x * 0.02) * 2.0);
	vec3 out_rgb = base_col.rgb + vec3(0.18, 0.06, 0.0) * lava_mask * pulse * 0.55;
	COLOR = vec4(out_rgb, base_col.a);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_lava_flow"]
shader = SubResource("Shader_lava_flow")

