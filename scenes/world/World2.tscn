[sub_resource type="Shader" id="Shader_chasm_flow"]
code = "shader_type canvas_item;

void fragment() {
	vec4 base_col = texture(TEXTURE, UV);
	bool in_chasm_zone = (UV.x > 0.42 && UV.x < 0.62);
	float water_mask = clamp((base_col.b - base_col.r * 1.45) * 4.5, 0.0, 1.0) * (in_chasm_zone ? 1.0 : 0.0);

	if (water_mask > 0.01) {
		vec2 wp = UV * vec2(2400.0, 1350.0);
		float ph1 = fract(TIME * 0.38);
		float ph2 = fract(TIME * 0.38 + 0.5);
		float w_blend = abs(ph1 - 0.5) * 2.0;

		float ripple_x = sin(wp.y * 0.05 - TIME * 4.5 + wp.x * 0.02) * 0.0025;
		vec2 uv1 = UV + vec2(ripple_x, -ph1 * 0.03);
		vec2 uv2 = UV + vec2(-ripple_x, -ph2 * 0.03);

		vec4 c1 = texture(TEXTURE, uv1);
		vec4 c2 = texture(TEXTURE, uv2);
		float m1 = clamp((c1.b - c1.r * 1.45) * 4.5, 0.0, 1.0);
		float m2 = clamp((c2.b - c2.r * 1.45) * 4.5, 0.0, 1.0);
		vec3 col1 = mix(base_col.rgb, c1.rgb, m1);
		vec3 col2 = mix(base_col.rgb, c2.rgb, m2);
		vec3 flowed = mix(col1, col2, w_blend);

		float stream_y = wp.y - TIME * 105.0;
		float wave1 = sin(stream_y * 0.08 + sin(wp.x * 0.06) * 2.5);
		float ribbon = smoothstep(0.60, 0.95, wave1);
		vec3 river_rgb = flowed + vec3(0.12, 0.28, 0.35) * ribbon * 0.6;
		COLOR = vec4(mix(base_col.rgb, river_rgb, water_mask), base_col.a);
	} else {
		COLOR = base_col;
	}
}
"

