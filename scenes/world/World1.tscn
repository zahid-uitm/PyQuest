[sub_resource type="Shader" id="Shader_8bit_river"]
code = "shader_type canvas_item;

void fragment() {
	vec4 base_col = texture(TEXTURE, UV);
	bool in_river_zone = (UV.x > 0.39 && UV.x < 0.64);
	// Mask that isolates only the cyan/blue river water, leaving bridges, rocks, and grass untouched
	float water_mask = clamp((base_col.b - base_col.r * 1.38) * 5.0, 0.0, 1.0) * (in_river_zone ? 1.0 : 0.0);

	if (water_mask > 0.01) {
		vec2 wp = UV * vec2(2400.0, 1350.0);
		// Dual-phase continuous downward UV flow so the water texture itself glides South
		float ph1 = fract(TIME * 0.35);
		float ph2 = fract(TIME * 0.35 + 0.5);
		float w_blend = abs(ph1 - 0.5) * 2.0;

		float ripple_x = sin(wp.y * 0.045 - TIME * 4.2 + wp.x * 0.02) * 0.0022;
		vec2 uv1 = UV + vec2(ripple_x, -ph1 * 0.028);
		vec2 uv2 = UV + vec2(-ripple_x, -ph2 * 0.028);

		vec4 c1 = texture(TEXTURE, uv1);
		vec4 c2 = texture(TEXTURE, uv2);
		float m1 = clamp((c1.b - c1.r * 1.38) * 5.0, 0.0, 1.0);
		float m2 = clamp((c2.b - c2.r * 1.38) * 5.0, 0.0, 1.0);
		vec3 col1 = mix(base_col.rgb, c1.rgb, m1);
		vec3 col2 = mix(base_col.rgb, c2.rgb, m2);
		vec3 flowed = mix(col1, col2, w_blend);

		// Downward-streaming current ribbons & water-crest sparkles
		float stream_y = wp.y - TIME * 95.0;
		float wave1 = sin(stream_y * 0.075 + sin(wp.x * 0.055) * 2.5);
		float wave2 = sin((wp.y - TIME * 65.0) * 0.12 - wp.x * 0.07);
		float ribbon = smoothstep(0.62, 0.95, wave1 * 0.6 + wave2 * 0.4);
		float crest = smoothstep(0.88, 0.99, sin(stream_y * 0.14 + wp.x * 0.11) * cos((wp.y - TIME * 120.0) * 0.09 - wp.x * 0.08));

		vec3 river_rgb = flowed + vec3(0.08, 0.20, 0.25) * ribbon * 0.55 + vec3(0.45, 0.52, 0.55) * crest * 0.65;
		COLOR = vec4(mix(base_col.rgb, river_rgb, water_mask), base_col.a);
	} else {
		COLOR = base_col;
	}
}
"

