[node name="Chests" type="Node2D" parent="YSortEntities" unique_id=304485676]

[node name="Chest1" parent="YSortEntities/Chests" unique_id=356596446 instance=ExtResource("11_chest")]
position = Vector2(1380, 960)
chest_id = "w4_chest_zero"
lore_title = "Why Python Lists Start at Index 0"
lore_text = "Catacomb Tablet I: In Python, an index measures the 'offset' from the beginning of the list. Because the first element is 0 steps away from the start, its index is always 0!"

[node name="Chest2" parent="YSortEntities/Chests" unique_id=1534014473 instance=ExtResource("11_chest")]
position = Vector2(190, 420)
chest_id = "w4_chest_append"
lore_title = "Mutable Lists vs. Immutable Strings"
lore_text = "Catacomb Tablet II: Lists are mutable! You can overwrite 'relics[0] = \"gold\"' or call 'relics.append(\"urn\")' directly without creating a brand-new list."

[node name="Chest3" parent="YSortEntities/Chests" unique_id=1914696030 instance=ExtResource("11_chest")]
position = Vector2(2150, 260)
chest_id = "w4_chest_slice"
lore_title = "The Secret of List Slicing [start:stop]"
lore_text = "Catacomb Tablet III: When slicing 'items[1:4]', Python includes the 'start' index (1) and stops just BEFORE the 'stop' index (4), returning elements at indices 1, 2, and 3!"

[node name="Chest4" parent="YSortEntities/Chests" unique_id=2091769941 instance=ExtResource("11_chest")]
position = Vector2(1375, 390)
chest_id = "w4_chest_in"
lore_title = "Instant Search with 'in'"
lore_text = "Catacomb Tablet IV: To check if a key is inside a list, write 'if \"skull_key\" in inventory:'. Python scans the sequence and returns True as soon as it finds a match!"

