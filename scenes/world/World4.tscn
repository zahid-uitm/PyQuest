[sub_resource type="Shader" id="Shader_catacombs_flow"]
code = "shader_type canvas_item;

void fragment() {
	vec4 base_col = texture(TEXTURE, UV);
	float emerald_mask = clamp((base_col.g - base_col.r * 1.35) * 4.2, 0.0, 1.0);
	float torch_mask = clamp((base_col.r - base_col.b * 1.6) * (base_col.g - base_col.b * 1.1) * 3.5, 0.0, 1.0);

	vec2 wp = UV * vec2(2400.0, 1350.0);
	float flow = 0.5 + 0.5 * sin(wp.y * 0.055 - TIME * 4.2 + sin(wp.x * 0.045) * 2.4);
	float flicker = 0.5 + 0.5 * sin(TIME * 7.5 + wp.x * 0.03);

	vec3 out_rgb = base_col.rgb;
	out_rgb += vec3(0.04, 0.28, 0.18) * emerald_mask * flow * 0.75;
	out_rgb += vec3(0.24, 0.12, 0.02) * torch_mask * flicker * 0.45;
	COLOR = vec4(out_rgb, base_col.a);
}
"

